<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:padding="20dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_title"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/main_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <Button
        android:id="@+id/btnActivity1"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_button_primary"
        android:drawableStart="@drawable/ic_arrow_right"
        android:drawablePadding="12dp"
        android:drawableTint="@color/text_on_primary"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/btn_activity1"
        android:textAllCaps="false"
        android:textColor="@color/text_on_primary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

    <Button
        android:id="@+id/btnActivity2"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_primary"
        android:drawableStart="@drawable/ic_arrow_right"
        android:drawablePadding="12dp"
        android:drawableTint="@color/text_on_primary"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/btn_activity2"
        android:textAllCaps="false"
        android:textColor="@color/text_on_primary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnActivity1" />

    <Button
        android:id="@+id/btnActivity3"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_primary"
        android:drawableStart="@drawable/ic_arrow_right"
        android:drawablePadding="12dp"
        android:drawableTint="@color/text_on_primary"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/btn_activity3"
        android:textAllCaps="false"
        android:textColor="@color/text_on_primary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnActivity2" />

    <Button
        android:id="@+id/btnActivity4"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_primary"
        android:drawableStart="@drawable/ic_arrow_right"
        android:drawablePadding="12dp"
        android:drawableTint="@color/text_on_primary"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/btn_activity4"
        android:textAllCaps="false"
        android:textColor="@color/text_on_primary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnActivity3" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:text="@string/result_hint"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnActivity4" />

</androidx.constraintlayout.widget.ConstraintLayout>
